# Copy to .env and fill in. 

# --- Object storage: S3/MinIO eksternal ---
# Host:port tanpa skema. Buckets di bawah harus sudah dibuat di sisi storage —
# worker tidak membuatnya sendiri.
S3_ENDPOINT_HOST=minio.example.com:9000
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_USE_SSL=true
S3_SUBMISSIONS_BUCKET=submissions
S3_SCREENSHOTS_BUCKET=screenshots

# --- Capture worker ---
SANDBOX_WORKER_PORT=8090

# Railpack talks to BuildKit directly. Only needed for the ZIP path.
BUILDKIT_HOST=docker-container://autograder-buildkit
