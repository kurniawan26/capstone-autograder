# Copy to .env and fill in. 

# --- Object storage / MinIO (docker-compose) ---
S3_ENDPOINT_HOST=localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_USE_SSL=false
S3_SUBMISSIONS_BUCKET=submissions
S3_SCREENSHOTS_BUCKET=screenshots

# --- Capture worker ---
SANDBOX_WORKER_PORT=8090

# Railpack talks to BuildKit directly. Only needed for the ZIP path.
BUILDKIT_HOST=docker-container://autograder-buildkit
